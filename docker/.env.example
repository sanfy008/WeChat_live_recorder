# 飞牛 NAS 服务端口
WXLIVE_PORT=8910

# SenseVoice ONNX 本地推理线程数（i7-6700 建议 4）
WXLIVE_LOCAL_THREADS=4

# 可选：AI 纠错与结构化要点整理（OpenAI 兼容接口）
# 也可部署后直接在网页右上角「设置」里填写并测试
WXLIVE_ENABLE_LLM=false
WXLIVE_LLM_ENDPOINT=
WXLIVE_LLM_API_KEY=
WXLIVE_LLM_MODEL=workbuddy/deepseek-v4.1-flash
# 思考强度（仅支持 none / low / high，推荐 low）
WXLIVE_LLM_EFFORT=low

# 可选：公网反代暴露时的访问令牌与域名白名单
# WXLIVE_TOKEN=
# WXLIVE_READ_AUTH=false
# WXLIVE_ALLOWED_HOSTS=one.20161213.xyz
